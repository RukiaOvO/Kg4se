# Neo4j 测试数据库
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASS=neo4j1234

# AI 配置（测试模式）
AI_PROVIDER=modelscope  # 或使用真实的 API key
AI_API_KEY=
AI_MODEL=MiniMax/MiniMax-M2.5
AI_BASE_URL=https://api-inference.modelscope.cn/v1
EMBEDDING_MODEL=text-embedding-v3

# 百度OCR 配置
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# Redis配置
REDIS_URL=redis://localhost:16379/0

# GraphRAG 配置
ENABLE_NEO4J_GRAPHRAG=true
ENABLE_VECTOR_SEARCH=true