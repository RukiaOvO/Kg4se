# Neo4j 测试数据库
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASS=neo4j1234

# AI 配置
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

# Redis配置
REDIS_URL=redis://localhost:16379/0

# GraphRAG 配置
ENABLE_NEO4J_GRAPHRAG=true
ENABLE_VECTOR_SEARCH=true

# 谓词治理配置
PREDICATE_STRICT_MODE=false          # 是否启用严格模式（只接受标准谓词）
PREDICATE_SIMILARITY_THRESHOLD=0.7   # 语义相似度阈值（0-1），高于此值才进行映射
