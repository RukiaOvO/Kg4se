# Neo4j 测试数据库
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASS=neo4j1234

# AI 配置
AI_PROVIDER=zhizengzeng
AI_API_KEY=
AI_MODEL=qwen3-max
JUDGE_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.zhizengzeng.com/v1

# 嵌入模型配置
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.zhizengzeng.com/v1

# 评估参数
EVALUATION_NUM_SAMPLES=3
EVALUATION_ENABLE_PAIRWISE=true
EVALUATION_POSITION_SWAP=true

# Redis配置
REDIS_URL=redis://localhost:16379/0

# GraphRAG 配置
ENABLE_NEO4J_GRAPHRAG=true
ENABLE_VECTOR_SEARCH=true

# 谓词治理配置
PREDICATE_STRICT_MODE=false          # 是否启用严格模式（只接受标准谓词）
PREDICATE_SIMILARITY_THRESHOLD=0.7   # 语义相似度阈值（0-1），高于此值才进行映射

# 日志配置
DEBUG=true
LOG_LEVEL=DEBUG

# docling 模型缓存配置
DOCLING_ARTIFACTS_PATH=../data/docling_models

# docling 内存优化配置
DOCLING_BATCH_SIZE=1
DOCLING_ENABLE_OCR=true
DOCLING_MAX_PAGES=
DOCLING_MEMORY_LIMIT_MB=4096